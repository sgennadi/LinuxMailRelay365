[Unit]
Requires=linuxmailrelay365-smtp-tls-initial-recovery.service
After=linuxmailrelay365-smtp-tls-initial-recovery.service
Description=Restore interrupted managed SMTP TLS generation before Postfix starts
Before=postfix.service
ConditionPathExists=/etc/postfix/lmr365-smtp-tls/deployment.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/linuxmailrelay365/manage-smtp-tls-renewal.py recover-before-start --confirm MANAGED_TLS_TRANSACTION
TimeoutStartSec=300

[Install]
RequiredBy=postfix.service
