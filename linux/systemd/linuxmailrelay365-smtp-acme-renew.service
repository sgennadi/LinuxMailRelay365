[Unit]
Description=LinuxMailRelay365 staged SMTP certificate renewal
Wants=network-online.target
After=network-online.target linuxmailrelay365-smtp-tls-recovery.service
Requires=linuxmailrelay365-smtp-tls-recovery.service
ConditionPathIsDirectory=/var/lib/linuxmailrelay365/smtp-acme/config/renewal
ConditionPathExists=/etc/postfix/lmr365-smtp-tls/renewal-profile.json

[Service]
Type=oneshot
User=root
UMask=0077
Environment=LC_ALL=C
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /usr/local/libexec/linuxmailrelay365/test-smtp-acme-renewal.py --live --confirm RUN_ACME_RENEWAL
TimeoutStartSec=1800
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/linuxmailrelay365/smtp-acme /etc/postfix/lmr365-smtp-tls /var/spool/postfix /var/lib/postfix
