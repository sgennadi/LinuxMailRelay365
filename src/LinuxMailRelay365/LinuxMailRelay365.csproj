    <EmbeddedResource Include="../../linux/manage-health-alerts.py" LogicalName="LinuxMailRelay365.linux.health-alerts.py" />
    <EmbeddedResource Include="../../linux/audit-m365-dns.py" LogicalName="LinuxMailRelay365.linux.m365-dns-audit.py" />
    <EmbeddedResource Include="../../linux/install-health-monitor.sh" LogicalName="LinuxMailRelay365.linux.health-monitor-installer.sh" />
    <EmbeddedResource Include="../../linux/verify-reboot-continuity.py" LogicalName="LinuxMailRelay365.linux.reboot-continuity.py" />
