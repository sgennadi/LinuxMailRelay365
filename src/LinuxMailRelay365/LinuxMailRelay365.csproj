<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Obsolete X.509 constructor regressions are build errors. -->
    <WarningsAsErrors>$(WarningsAsErrors);SYSLIB0057</WarningsAsErrors>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>0.1.1-rc.19</Version>
    <!-- Standalone builds work in a public repository. Reuse the user's private
         UniversalUpdater module when it has been restored locally. -->
    <UseSharedUpdater Condition="'$(UseSharedUpdater)' == '' and Exists('../../modules/UniversalUpdater/src/UniversalUpdater.Core/UniversalUpdater.Core.csproj')">true</UseSharedUpdater>
    <UseSharedUpdater Condition="'$(UseSharedUpdater)' == ''">false</UseSharedUpdater>
    <DefineConstants Condition="'$(UseSharedUpdater)' == 'true'">$(DefineConstants);USE_UNIVERSAL_UPDATER</DefineConstants>
    <AssemblyName>LinuxMailRelay365</AssemblyName>
    <ApplicationIcon>Assets/LinuxMailRelay365.ico</ApplicationIcon>
  </PropertyGroup>
