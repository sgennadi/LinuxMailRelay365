<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>0.1.0-preview.15</Version>
    <!-- Standalone builds work in a public repository. Reuse the user's private
         UniversalUpdater module when it has been restored locally. -->
    <UseSharedUpdater Condition="'$(UseSharedUpdater)' == '' and Exists('../../modules/UniversalUpdater/src/UniversalUpdater.Core/UniversalUpdater.Core.csproj')">true</UseSharedUpdater>
    <UseSharedUpdater Condition="'$(UseSharedUpdater)' == ''">false</UseSharedUpdater>
    <DefineConstants Condition="'$(UseSharedUpdater)' == 'true'">$(DefineConstants);USE_UNIVERSAL_UPDATER</DefineConstants>
    <AssemblyName>LinuxMailRelay365</AssemblyName>
    <ApplicationIcon>Assets/LinuxMailRelay365.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/LinuxMailRelay365.ico" LogicalName="LinuxMailRelay365.BrandIcon" />
    <!-- SSH.NET is used only for password authentication; OpenSSH key/agent mode stays supported. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <ProjectReference Include="../../modules/UniversalUpdater/src/UniversalUpdater.Core/UniversalUpdater.Core.csproj"
                      Condition="'$(UseSharedUpdater)' == 'true'" />
    <EmbeddedResource Include="../../linux/install-postfix-m365-xoauth2.sh" LogicalName="LinuxMailRelay365.linux.install.sh" />
    <EmbeddedResource Include="../../linux/m365_xoauth2_transport.py" LogicalName="LinuxMailRelay365.linux.transport.py" />
    <EmbeddedResource Include="../../linux/probe-linux.sh" LogicalName="LinuxMailRelay365.linux.security-probe.sh" />
    <EmbeddedResource Include="../../linux/mail-config-recovery.sh" LogicalName="LinuxMailRelay365.linux.recovery.sh" />
    <EmbeddedResource Include="../../linux/install-preserve-postfix-sidecar.sh" LogicalName="LinuxMailRelay365.linux.sidecar.sh" />
    <EmbeddedResource Include="../../linux/install-direct-send-sidecar.sh" LogicalName="LinuxMailRelay365.linux.direct-send-sidecar.sh" />
    <EmbeddedResource Include="../../linux/install-connector-sidecar.sh" LogicalName="LinuxMailRelay365.linux.connector-sidecar.sh" />
    <EmbeddedResource Include="../../linux/guard-foreign-mta.py" LogicalName="LinuxMailRelay365.linux.foreign-mta-guard.py" />
    <EmbeddedResource Include="../../linux/network-firewall.sh" LogicalName="LinuxMailRelay365.linux.network-firewall.sh" />
    <EmbeddedResource Include="../../linux/manage-public-smtp.py" LogicalName="LinuxMailRelay365.linux.public-smtp-manager.py" />
    <EmbeddedResource Include="../../linux/audit-existing-smtp.py" LogicalName="LinuxMailRelay365.linux.existing-smtp-audit.py" />
    <EmbeddedResource Include="../../linux/platform-compat.py" LogicalName="LinuxMailRelay365.linux.platform-compat.py" />
    <EmbeddedResource Include="../../linux/mta-coexistence-doctor.py" LogicalName="LinuxMailRelay365.linux.mta-coexistence-doctor.py" />
    <EmbeddedResource Include="../../linux/rhel-selinux-doctor.py" LogicalName="LinuxMailRelay365.linux.rhel-selinux-doctor.py" />
    <EmbeddedResource Include="../../linux/rhel-enforcing-live-smoke.py" LogicalName="LinuxMailRelay365.linux.rhel-enforcing-live-smoke.py" />
    <EmbeddedResource Include="../../linux/manage-rhel-selinux-port.py" LogicalName="LinuxMailRelay365.linux.rhel-selinux-port-manager.py" />
    <EmbeddedResource Include="../../linux/manage-sidecar-smtp-accounts.py" LogicalName="LinuxMailRelay365.linux.smtp-account-manager.py" />
    <EmbeddedResource Include="../../linux/generate-smtp-client-credential.py" LogicalName="LinuxMailRelay365.linux.smtp-credential-generator.py" />
